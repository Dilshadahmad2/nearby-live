DATABASE_URL=postgres://nearby:nearby@localhost:5432/nearby?sslmode=disable
PORT=8080
DATA_DIR=data
SEED_IF_EMPTY=true
# Set to enable PUT /v1/admin/stations/{code} and POST /v1/admin/reload
ADMIN_TOKEN=
LOG_LEVEL=info

# Live data
LIVE_TRAINS_INTERVAL=30s
# Live delay API (see README "Live train delays"); keys go in the headers.
DELAY_PROVIDER_URL=
DELAY_PROVIDER_NAME=
DELAY_PROVIDER_HEADERS=
DELAY_PATH=
DELAY_STATION_PATH=
DELAY_LAT_PATH=
DELAY_LON_PATH=
DELAY_OK_PATH=
DELAY_MESSAGE_PATH=
DELAY_TTL=3m
DELAY_DAILY_LIMIT=500
# Flights
LIVE_FLIGHTS=true
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_DAILY_CREDITS=
OPENSKY_SWEEP_INTERVAL=
OPENSKY_BBOX=6,68,37.5,97.5
# WebSocket stream
WS_MAX_CONNS=1000
WS_MIN_INTERVAL=1s
WS_ORIGINS=
# Weather (Open-Meteo, no key) and traffic (TomTom key stays on the server)
WEATHER_MAX_AGE=10m
TOMTOM_KEY=
TOMTOM_DAILY_REQUESTS=2000
TRAFFIC_MAX_AGE=3m
# Push alerts
FCM_SERVICE_ACCOUNT_FILE=
ALERT_WEBHOOK_URL=
ALERT_INTERVAL=30s
ALERT_COOLDOWN=1h
